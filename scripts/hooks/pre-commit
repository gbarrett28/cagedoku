#!/bin/bash
# pre-commit hook: enforce quality gates before every commit.
#
# Install: bash scripts/hooks/install.sh
#
# master/main    — silver gate token required (created by scripts/run-silver-gate.sh)
# feature branch — bronze gate token required (created by scripts/run-bronze-gate.sh)
#
# The token scripts actually run the checks; requiring the token here means
# the checks were genuinely executed, not just confirmed on trust.

REPO_ROOT="$(git rev-parse --show-toplevel)"
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# ── Silver gate (master / main) ─────────────────────────────────────────────

if [[ "$BRANCH" == "master" || "$BRANCH" == "main" ]]; then
  TOKEN="$REPO_ROOT/.silver-gate-ok"

  if [ ! -f "$TOKEN" ]; then
    echo ""
    echo "BLOCKED: silver gate token not found."
    echo ""
    echo "Run the silver gate (executes all checks + doc-hygiene prompt):"
    echo "  bash scripts/run-silver-gate.sh"
    echo ""
    echo "Then commit:"
    echo "  git merge feature/<name>   or   git commit"
    echo ""
    exit 1
  fi

  rm "$TOKEN"
  echo "Silver gate token consumed — commit proceeding."
  echo ""
  exit 0
fi

# ── Bronze gate (feature branches) ──────────────────────────────────────────

TOKEN="$REPO_ROOT/.bronze-gate-ok"

if [ ! -f "$TOKEN" ]; then
  echo ""
  echo "BLOCKED: bronze gate token not found."
  echo ""
  echo "Run the bronze gate (executes tsc + npm test):"
  echo "  bash scripts/run-bronze-gate.sh"
  echo ""
  echo "Then commit."
  echo ""
  exit 1
fi

rm "$TOKEN"
echo "Bronze gate token consumed — commit proceeding."
echo ""
exit 0
